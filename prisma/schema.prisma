datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  EMPLOYEE
  PARTNER_OFFICE
  ADMIN
  SUPER_ADMIN
  MANAGER
  COUNTER_EMPLOYEE
  ACCOUNTANT
}

enum OfficeType {
  HEAD_OFFICE
  REGIONAL_OFFICE
  BRANCH
  PARTNER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
}

enum VehicleStatus {
  AVAILABLE
  IN_SERVICE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum RouteStatus {
  ACTIVE
  SUSPENDED
  UNDER_MAINTENANCE
  CLOSED
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  SYSTEM
}

enum ActivitySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum BookingStatus {
  DRAFT
  BOOKED
  PICKUP_REQUESTED
  RECEIVED_AT_ORIGIN
  RECEIVED_AT_ORIGIN_OFFICE
  SORTED
  LOADED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  ARRIVED_AT_DESTINATION_OFFICE
  UNLOADED
  READY_FOR_COLLECTION
  COLLECTED
  COMPLETED
  CANCELLED
  DELAYED
  HOLD
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED_TO_ORIGIN
}

enum DispatchStatus {
  CREATED
  READY
  DEPARTED
  ARRIVED
  CLOSED
  CANCELLED
}

enum DelayReason {
  TRAFFIC
  VEHICLE_BREAKDOWN
  WEATHER
  ROAD_BLOCK
  STRIKE
  OTHER
}

enum HoldReason {
  DOCUMENT_PENDING
  PAYMENT_PENDING
  CUSTOMER_REQUEST
  DAMAGED_PARCEL
  OTHER
}

enum TrackingRemarkType {
  SYSTEM
  EMPLOYEE
  PARTNER
  CUSTOMER_SERVICE
}

enum PickupMethod {
  SELF_DROP
  TAXI_PICKUP
}

enum PaymentType {
  PAID
  TO_PAY
}

enum PaymentMode {
  CASH
  UPI
}

enum ParcelType {
  ENVELOPE
  BOX
  MEDIUM_PARCEL
  LARGE_BUNDLE
}

model RoleModel {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  code        String           @unique // e.g. "offices:manage", "bookings:read"
  description String?

  roles       RolePermission[]

  @@index([module])
  @@index([code])
}

model RolePermission {
  roleId       String
  permissionId String
  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model CompanySettings {
  id          String   @id @default("default")
  companyName String   @default("POOJA TRAVELS & CARGO")
  tagline     String   @default("Powered by POOJA TRAVELS & CARGO")
  logo        String?
  favicon     String?
  gst         String?
  pan         String?
  upiId       String?  @default("6350603414@upi")
  upiQr       String?
  helpline1   String   @default("6350603414")
  helpline2   String   @default("7852091119")
  helpline3   String   @default("0291-2651955")
  supportEmail String  @default("support@poojatravels.com")
  website     String   @default("https://shipkart.com")
  address     String   @default("45, Jaswant Building, MG Hospital Rd, Sojati Gate, Rawaton Ka Bass, Jodhpur, Rajasthan 342001")
  mapEmbed    String   @default("https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3577.2652977703!2d73.01826457502641!3d26.285498277026598!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39418da8481efa59%3A0x86303ce101608fd5!2sPooja%20Travels!5e0!3m2!1sen!2sin!4v1784796454580!5m2!1sen!2sin")
  terms       String   @default("1. Receiver must show valid ID for parcel collection.\n2. Goods transported at owner's risk.\n3. Claims must be made within 24 hours of arrival.")
  privacyPolicy String @default("Privacy policy terms apply to all transactions.")
  updatedAt   DateTime @updatedAt
}

model BookingSettings {
  id                  String   @id @default("default")
  bookingPrefix       String   @default("SK")
  dispatchPrefix      String   @default("DISP")
  autoAssignVehicle   Boolean  @default(false)
  maxWeightPerParcel  Float    @default(100.0)
  allowTaxiPickup     Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model BrandingSettings {
  id             String   @id @default("default")
  primaryColor   String   @default("#f97316")
  secondaryColor String   @default("#1e293b")
  logoUrl        String?
  faviconUrl     String?
  emailBannerUrl String?
  updatedAt      DateTime @updatedAt
}

model NotificationSettings {
  id                        String   @id @default("default")
  whatsappEnabled           Boolean  @default(true)
  smsEnabled                Boolean  @default(true)
  emailEnabled              Boolean  @default(true)
  pushEnabled               Boolean  @default(true)
  notifyCustomerOnBooking   Boolean  @default(true)
  notifyCustomerOnDispatch  Boolean  @default(true)
  notifyCustomerOnArrival   Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

model FinanceSettings {
  id             String   @id @default("default")
  currency       String   @default("INR")
  currencySymbol String   @default("₹")
  taxPercentage  Float    @default(18.0)
  gstin          String?
  upiId          String   @default("6350603414@upi")
  updatedAt      DateTime @updatedAt
}

model SecuritySettings {
  id                     String   @id @default("default")
  maxFailedLoginAttempts Int      @default(5)
  sessionTimeoutMinutes  Int      @default(120)
  enforcePasswordPolicy  Boolean  @default(true)
  require2FA             Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model SystemSettings {
  id                 String   @id @default("default")
  timezone           String   @default("Asia/Kolkata")
  maintenanceMode    Boolean  @default(false)
  systemVersion      String   @default("1.0.0")
  allowRegistrations Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model User {
  id                    String          @id @default(uuid())
  supabaseAuthId        String?         @unique
  employeeCode          String?         @unique
  name                  String
  phone                 String          @unique
  email                 String?         @unique
  role                  Role            @default(CUSTOMER)
  designation           String?
  joiningDate           DateTime?
  employeeStatus        EmployeeStatus  @default(ACTIVE)
  emergencyContact      String?
  aadhaarDoc            String?
  panDoc                String?
  drivingLicenseDoc     String?
  lastLoginAt           DateTime?
  failedLoginAttempts   Int             @default(0)
  accountLocked         Boolean         @default(false)
  passwordResetRequired Boolean         @default(false)
  passwordChangedAt     DateTime?
  officeId              String?
  office                OfficeMaster?   @relation(fields: [officeId], references: [id])
  photo                 String?
  alternatePhone        String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  profilePhoto          String?
  status                Boolean         @default(true)

  allowSMS              Boolean         @default(true)
  allowEmail            Boolean         @default(true)
  allowMarketing        Boolean         @default(false)
  allowPush             Boolean         @default(true)
  preferredLanguage     String          @default("en")
  isActive              Boolean         @default(true)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  createdBookings       Booking[]       @relation("CreatedBy")
  trackingUpdates       TrackingHistory[]
  activityLogs          ActivityLog[]
  savedReceivers        SavedReceiver[]
  broadcasts            BroadcastNotification[]
  userRoles             UserRole[]
  attendances           Attendance[]
  driverVehicles        VehicleMaster[] @relation("AssignedDriver")

  @@index([officeId])
  @@index([phone])
  @@index([role])
  @@index([employeeCode])
  @@index([isActive])
}

model Attendance {
  id               String           @id @default(uuid())
  employeeId       String
  employee         User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             String           // YYYY-MM-DD
  clockIn          DateTime?
  clockOut         DateTime?
  breakDurationMins Int             @default(0)
  status           AttendanceStatus @default(PRESENT)
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model SavedReceiver {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  city       String?
  createdAt  DateTime @default(now())
}

model OfficeMaster {
  id                     String      @id @default(uuid())
  officeCode             String?     @unique
  name                   String      @unique
  code                   String?     @unique // e.g. JDH01, JPR01
  officeType             OfficeType  @default(BRANCH)
  parentOfficeId         String?
  parentOffice           OfficeMaster? @relation("OfficeHierarchy", fields: [parentOfficeId], references: [id])
  subOffices             OfficeMaster[] @relation("OfficeHierarchy")
  address                String
  city                   String      @default("Jodhpur")
  state                  String      @default("Rajasthan")
  pinCode                String      @default("342001")
  country                String      @default("India")
  phone                  String
  altPhone               String?
  managerName            String?
  managerPhone           String?
  managerEmail           String?
  latitude               Float
  longitude              Float
  googleMapsUrl          String?
  openingTime            String      @default("04:00 AM")
  closingTime            String      @default("11:00 PM")
  officeTiming           String      @default("04:00 AM - 11:00 PM")
  workingDays            String      @default("Mon-Sat")
  maximumStorageCapacity Int         @default(1000)
  currentStorageCapacity Int         @default(0)
  gstDoc                 String?
  panDoc                 String?
  images                 String[]    @default([])
  status                 Boolean     @default(true)
  isActive               Boolean     @default(true)
  deletedAt              DateTime?
  deletedBy              String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  pricingGroupId         String?
  pricingGroup           PricingGroup? @relation("DestinationPricingGroup", fields: [pricingGroupId], references: [id])

  users                  User[]
  holidays               Holiday[]
  originRoutes           RouteMaster[] @relation("OriginOffice")
  destRoutes             RouteMaster[] @relation("DestinationOffice")
  originBookings         Booking[]    @relation("BookingOriginOffice")
  destBookings           Booking[]    @relation("BookingDestOffice")
  currentBookings        Booking[]    @relation("BookingCurrentOffice")
  nextBookings           Booking[]    @relation("BookingNextOffice")
  dispatchOrigins        Dispatch[]   @relation("DispatchOriginOffice")
  dispatchDests          Dispatch[]   @relation("DispatchDestOffice")
  trackingHistories      TrackingHistory[]
  cashBookEntries        CashBook[]
  officeClosings         OfficeClosing[]
  expenses               Expense[]


  @@index([city])
  @@index([state])
  @@index([status])
  @@index([isActive])
  @@index([officeCode])
  @@index([parentOfficeId])
}

model Holiday {
  id          String        @id @default(uuid())
  officeId    String?
  office      OfficeMaster? @relation(fields: [officeId], references: [id], onDelete: Cascade)
  holidayDate String        // YYYY-MM-DD
  title       String
  description String?
  createdAt   DateTime      @default(now())

  @@index([officeId])
  @@index([holidayDate])
}

model VehicleMaster {
  id                 String        @id @default(uuid())
  vehicleNumber      String        @unique // e.g. RJ19-GB-1234
  vehicleType        String        @default("TRUCK")
  registrationNumber String
  capacityKg         Float         @default(1000.0)
  status             VehicleStatus @default(AVAILABLE)
  driverEmployeeId   String?
  driverEmployee     User?         @relation("AssignedDriver", fields: [driverEmployeeId], references: [id])
  driverName         String?
  driverPhone        String?
  insuranceExpiry    DateTime?
  permitExpiry       DateTime?
  fitnessExpiry      DateTime?
  pollutionExpiry    DateTime?
  insuranceDoc       String?
  registrationDoc    String?
  fitnessDoc         String?
  permitDoc          String?
  pollutionDoc       String?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  maintenanceCost    Float         @default(0)
  odometer           Float         @default(0)
  isActive           Boolean       @default(true)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  maintenanceHistory VehicleMaintenanceHistory[]

  @@index([vehicleNumber])
  @@index([status])
  @@index([isActive])
}

model VehicleMaintenanceHistory {
  id              String        @id @default(uuid())
  vehicleId       String
  vehicle         VehicleMaster @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDate     DateTime
  serviceType     String
  cost            Float
  odometerReading Float?
  invoiceNumber   String?
  description     String?
  performedBy     String?
  createdAt       DateTime      @default(now())

  @@index([vehicleId])
  @@index([serviceDate])
}

model RouteMaster {
  id                  String       @id @default(uuid())
  routeCode           String?      @unique
  originOfficeId      String
  originOffice        OfficeMaster @relation("OriginOffice", fields: [originOfficeId], references: [id])
  destinationOfficeId String
  destinationOffice   OfficeMaster @relation("DestinationOffice", fields: [destinationOfficeId], references: [id])
  etaHours            Float        @default(12.0)
  distanceKm          Float        @default(100.0)
  operatingDays       String       @default("Daily")
  departureTime       String?      @default("08:00 PM")
  arrivalTime         String?      @default("06:00 AM")
  isBidirectional     Boolean      @default(true)
  status              Boolean      @default(true)
  routeStatus         RouteStatus  @default(ACTIVE)
  effectiveFrom       DateTime?
  effectiveTill       DateTime?
  closureReason       String?
  isActive            Boolean      @default(true)
  deletedAt           DateTime?
  pricingGroupId      String?
  pricingGroup        PricingGroup? @relation(fields: [pricingGroupId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  dispatches          Dispatch[]

  @@unique([originOfficeId, destinationOfficeId])
  @@index([originOfficeId])
  @@index([destinationOfficeId])
  @@index([status])
  @@index([routeStatus])
  @@index([isActive])
  @@index([routeCode])
}

model PricingGroup {
  id            String   @id @default(uuid())
  pricingCode   String?  @unique
  name          String   @unique
  description   String?
  isRajasthan   Boolean  @default(true)
  version       Int      @default(1)
  effectiveFrom DateTime?
  effectiveTill DateTime?
  status        Boolean  @default(true)
  isActive      Boolean  @default(true)
  deletedAt     DateTime?

  pricingRules PricingRule[]
  routes       RouteMaster[]
  destOffices  OfficeMaster[] @relation("DestinationPricingGroup")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isRajasthan])
  @@index([status])
  @@index([isActive])
  @@index([pricingCode])
}

model PricingRule {
  id             String       @id @default(uuid())
  pricingGroupId String
  pricingGroup   PricingGroup @relation(fields: [pricingGroupId], references: [id], onDelete: Cascade)

  parcelType     ParcelType
  selfPrice      Float
  taxiPrice      Float?       // null indicates Taxi Pickup is unavailable for this parcel type (e.g. ENVELOPE)
  displayOrder   Int          @default(1)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([pricingGroupId, parcelType])
  @@index([pricingGroupId])
}

model SequenceMaster {
  key        String   @id // OFF, EMP, VEH, ROUTE, PRICE, ACT
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model LRSequence {
  id         Int      @id @default(1)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model DispatchSequence {
  id         Int      @id @default(1)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Booking {
  id                  String          @id @default(uuid())
  lrNumber            String          @unique // e.g. SK000000001 (Global Sequence)
  senderName          String
  senderPhone         String
  senderEmail         String?
  receiverName        String
  receiverPhone       String
  originOfficeId      String
  originOffice        OfficeMaster    @relation("BookingOriginOffice", fields: [originOfficeId], references: [id])
  destinationOfficeId String
  destinationOffice   OfficeMaster    @relation("BookingDestOffice", fields: [destinationOfficeId], references: [id])

  currentOfficeId     String?
  currentOffice       OfficeMaster?   @relation("BookingCurrentOffice", fields: [currentOfficeId], references: [id])
  nextOfficeId        String?
  nextOffice          OfficeMaster?   @relation("BookingNextOffice", fields: [nextOfficeId], references: [id])
  
  pickupMethod        PickupMethod    @default(SELF_DROP)
  pickupAddress       String?
  latitude            Float?
  longitude           Float?
  locationAccuracy    Float?
  
  paymentType         PaymentType     @default(PAID)
  paymentMode         PaymentMode     @default(CASH)
  paymentStatus       Boolean         @default(true)
  
  subtotalAmount      Float           @default(0)
  totalPickupCharge   Float           @default(0)
  totalAmount         Float
  specialNotes        String?
  status              BookingStatus   @default(BOOKED)

  estimatedArrival    DateTime?
  actualArrival       DateTime?
  lastUpdatedAt       DateTime?
  lastUpdatedBy       String?

  delayReason         DelayReason?
  holdReason          HoldReason?
  version             Int             @default(1)

  collectionStatus    CollectionStatus @default(PENDING)
  arrivedAtOfficeAt   DateTime?
  collectedAt         DateTime?
  collectedBy         String?

  createdById         String?
  createdBy           User?           @relation("CreatedBy", fields: [createdById], references: [id])
  
  dispatchId          String?
  dispatch            Dispatch?       @relation(fields: [dispatchId], references: [id])

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  items               ConsignmentItem[]
  trackingHistory     TrackingHistory[]
  notifications       NotificationQueue[]
  dispatchItems       DispatchItem[]
  collectionOtp       CollectionOTP?
  cashBookEntries     CashBook[]

  @@index([lrNumber])
  @@index([senderPhone])
  @@index([receiverPhone])
  @@index([status])
  @@index([originOfficeId])
  @@index([destinationOfficeId])
  @@index([currentOfficeId])
  @@index([createdById])
  @@index([createdAt])
}

enum CollectionStatus {
  PENDING
  READY
  COLLECTED
}

model CollectionOTP {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  otp        String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([bookingId])
}

enum CashTransactionType {
  BOOKING_PAYMENT
  TO_PAY_COLLECTION
  EXPENSE
  OPENING_BALANCE
  CLOSING_BALANCE
  ADJUSTMENT
}

enum ExpenseCategory {
  DIESEL
  SALARY
  OFFICE
  MAINTENANCE
  FOOD
  OTHER
}

model CashBook {
  id              String              @id @default(uuid())
  officeId        String
  office          OfficeMaster        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  transactionType CashTransactionType
  bookingId       String?
  booking         Booking?            @relation(fields: [bookingId], references: [id])
  amount          Float
  description     String?
  createdBy       String
  createdAt       DateTime            @default(now())

  @@index([officeId])
  @@index([createdAt])
}

model OfficeClosing {
  id             String       @id @default(uuid())
  officeId       String
  office         OfficeMaster @relation(fields: [officeId], references: [id], onDelete: Cascade)
  openingCash    Float
  bookingCash    Float
  toPayCollected Float
  expenses       Float
  closingCash    Float
  closedBy       String
  closedAt       DateTime     @default(now())
  remarks        String?

  @@index([officeId])
  @@index([closedAt])
}

model Expense {
  id          String          @id @default(uuid())
  officeId    String
  office      OfficeMaster    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Float
  description String?
  createdBy   String
  createdAt   DateTime        @default(now())

  @@index([officeId])
  @@index([createdAt])
}


model ConsignmentItem {
  id               String     @id @default(uuid())
  bookingId        String
  booking          Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  parcelType       ParcelType @default(BOX)
  quantity         Int        @default(1)
  weightKg         Float?     @default(1.0)
  dimensions       String?
  photoUrl         String?
  remarks          String?

  // Price Snapshots (Immutable once booked)
  unitPrice        Float      @default(0)
  selfPrice        Float      @default(0)
  taxiPrice        Float?
  subtotal         Float      @default(0)
  itemPickupCharge Float      @default(0)

  createdAt        DateTime   @default(now())
}

model NotificationSequence {
  id         Int      @id @default(1)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationRecipientType {
  SENDER
  RECEIVER
  EMPLOYEE
  PARTNER_OFFICE
  ADMIN
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationEvent {
  BOOKING_CREATED
  BOOKING_CANCELLED
  PICKUP_REQUESTED
  PARCEL_RECEIVED
  PARCEL_SORTED
  PARCEL_LOADED
  DISPATCH_DEPARTED
  IN_TRANSIT
  ARRIVED_DESTINATION
  READY_FOR_COLLECTION
  COLLECTED
  COMPLETED
  RETURN_REQUESTED
  RETURN_COMPLETED
  BROADCAST_ANNOUNCEMENT
}

model NotificationTemplate {
  id              String              @id @default(uuid())
  name            String
  event           NotificationEvent
  channel         NotificationChannel
  languageCode    String              @default("en")
  version         Int                 @default(1)
  title           String?
  messageTemplate String
  variables       String?             // JSON string of required variable names e.g. ["receiverName", "lrNumber"]
  isActive        Boolean             @default(true)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  notifications   NotificationQueue[]

  @@unique([event, channel, languageCode, version])
  @@index([event])
  @@index([channel])
  @@index([languageCode])
  @@index([isActive])
}

model NotificationQueue {
  id                   String                    @id @default(uuid())
  queueNumber          String                    @unique
  deduplicationKey     String                    @unique
  eventHash            String?
  bookingId            String?
  booking              Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lrNumber             String?
  recipientType        NotificationRecipientType @default(SENDER)
  recipientId          String?
  recipientName        String
  recipientPhone       String?
  recipientEmail       String?
  channel              NotificationChannel       @default(WHATSAPP)
  fallbackChannels     String?                   // Comma-separated list e.g. "SMS,EMAIL"
  priority             NotificationPriority      @default(NORMAL)
  event                NotificationEvent
  status               NotificationStatus        @default(PENDING)
  message              String
  templateId           String?
  template             NotificationTemplate?     @relation(fields: [templateId], references: [id])
  provider             String?
  providerMessageId    String?
  retryCount           Int                       @default(0)
  maxRetries           Int                       @default(3)
  scheduledAt          DateTime                  @default(now())
  availableAt          DateTime                  @default(now())
  expiresAt            DateTime?
  processedAt          DateTime?
  failureReason        String?
  attachmentUrl        String?
  attachmentType       String?
  processingStartedAt  DateTime?
  workerId             String?
  lockedUntil          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  history              NotificationHistory[]
  audits               NotificationAudit[]

  @@index([bookingId])
  @@index([status, availableAt, priority])
  @@index([deduplicationKey])
  @@index([event])
  @@index([channel])
  @@index([createdAt])
}

model NotificationHistory {
  id               String             @id @default(uuid())
  queueId          String
  queue            NotificationQueue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  status           NotificationStatus
  channel          NotificationChannel
  provider         String?
  providerResponse String?
  createdAt        DateTime           @default(now())

  @@index([queueId])
  @@index([createdAt])
}

model NotificationAudit {
  id        String            @id @default(uuid())
  queueId   String
  queue     NotificationQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  action    String
  userId    String?
  oldStatus NotificationStatus?
  newStatus NotificationStatus?
  timestamp DateTime          @default(now())

  @@index([queueId])
  @@index([timestamp])
}

model BroadcastNotification {
  id             String              @id @default(uuid())
  title          String
  message        String
  targetRole     Role?
  channel        NotificationChannel @default(WHATSAPP)
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])
  recipientCount Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@index([createdAt])
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  bookingId  String
  createdAt  DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([dispatchId, bookingId])
  @@index([dispatchId])
  @@index([bookingId])
}

model Dispatch {
  id                  String         @id @default(uuid())
  dispatchNumber      String         @unique @default(uuid())
  vehicleNumber       String
  driverName          String?
  driverPhone         String?
  routeId             String?
  route               RouteMaster?   @relation(fields: [routeId], references: [id])
  originOfficeId      String?
  originOffice        OfficeMaster?  @relation("DispatchOriginOffice", fields: [originOfficeId], references: [id])
  destinationOfficeId String?
  destinationOffice   OfficeMaster?  @relation("DispatchDestOffice", fields: [destinationOfficeId], references: [id])
  departureTime       DateTime?
  estimatedArrival    DateTime?
  actualArrival       DateTime?
  status              DispatchStatus @default(CREATED)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bookings            Booking[]
  dispatchItems       DispatchItem[]
  trackingHistories   TrackingHistory[]

  @@index([dispatchNumber])
  @@index([status])
}

model TrackingHistory {
  id                   String             @id @default(uuid())
  bookingId            String
  booking              Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dispatchId           String?
  dispatch             Dispatch?          @relation(fields: [dispatchId], references: [id])
  status               BookingStatus
  title                String?
  publicRemarks        String?
  internalRemarks      String?
  remarkType           TrackingRemarkType @default(EMPLOYEE)
  receiverNameVerified String?
  receiverPhoneVerified String?
  officeId             String?
  office               OfficeMaster?      @relation(fields: [officeId], references: [id])
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])
  latitude             Float?
  longitude            Float?
  notes                String?
  createdAt            DateTime           @default(now())

  @@index([bookingId])
  @@index([createdAt])
  @@index([dispatchId])
}

model StatusMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int
  color     String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id             String           @id @default(uuid())
  activityNumber String?          @unique
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  userRole       String?
  officeId       String?
  sessionId      String?
  deviceType     String?
  browser        String?
  OS             String?
  requestId      String?
  activityType   ActivityType     @default(SYSTEM)
  severity       ActivitySeverity @default(INFO)
  module         String?
  entity         String?
  entityId       String?
  action         String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  ip             String?
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([activityType])
  @@index([severity])
  @@index([officeId])
}

model DailyClosingReport {
  id                 String   @id @default(uuid())
  date               String   @unique // YYYY-MM-DD
  totalBookings      Int      @default(0)
  onlineBookings     Int      @default(0)
  offlineBookings    Int      @default(0)
  paidBookings       Int      @default(0)
  toPayBookings      Int      @default(0)
  cashRevenue        Float    @default(0)
  upiRevenue         Float    @default(0)
  totalRevenue       Float    @default(0)
  taxiPickups        Int      @default(0)
  selfDrops          Int      @default(0)
  pendingCollections Int      @default(0)
  completedDeliveries Int     @default(0)
  topRoute           String?
  createdAt          DateTime @default(now())
}

model DashboardWidget {
  id           String   @id @default(uuid())
  title        String
  widgetType   String
  position     Int      @default(0)
  enabled      Boolean  @default(true)
  allowedRoles String[] @default(["ADMIN", "SUPER_ADMIN"])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model ReportCache {
  id          String   @id @default(uuid())
  reportType  String
  filters     Json
  generatedBy String
  data        Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([reportType])
  @@index([expiresAt])
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model OperationalAlert {
  id             String        @id @default(uuid())
  alertNumber    String        @unique
  severity       AlertSeverity
  status         AlertStatus   @default(ACTIVE)
  title          String
  description    String
  module         String

  officeId       String?
  bookingId      String?
  dispatchId     String?
  employeeId     String?

  detectedAt     DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  acknowledgedBy String?
  resolvedBy     String?

  createdAt      DateTime      @default(now())

  @@index([status])
  @@index([severity])
  @@index([officeId])
  @@index([createdAt])
}

